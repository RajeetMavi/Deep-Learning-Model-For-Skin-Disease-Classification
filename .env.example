# Example Environment Variables for Skin Lesion Classification Project
# Copy this file to .env for local testing (never commit real secrets to git)

# Django secret key (set a secure random string in production)
SECRET_KEY=your-production-secret-key-here-minimum-50-characters

# Set to False in production
DEBUG=False

# Comma-separated allowed hostnames (Render automatically adds RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated trusted origins for CSRF protection over HTTPS
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Port assigned by hosting platform (default: 8000 for local, 10000 on Render)
PORT=8000

# Low-RAM memory optimization flags for Linux hosting
MALLOC_ARENA_MAX=2
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=3

